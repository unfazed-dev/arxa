{
 "app": "studio",
 "vocabulary": "shell > view > widgets; the hub is the routed root frame (/) hosting the stage shells (header, tabbar, rail chrome + body outlet); ceremony shells route bare",
 "note": "Derived projection of intake/registry.json (the authoring SSOT). Q-v2-5 originally cut shells over one at a time behind explicit user validation; the owner ruling of 2026-08-16 landed every shell enabled in one pass, so every stage routes today. Boot-guarded working stages carry booted() in app.routes.js with ?to return-to (R1-R4, docs/plans/studio-v2-boot-sequence-wiring.md).",
 "stages": [
  {
   "id": "startup",
   "labelKey": "stageStartup",
   "shell": "studio_startup_shell",
   "consumes": "arxa.config.json",
   "produces": "session",
   "href": "/startup",
   "enabled": true
  },
  {
   "id": "auth",
   "labelKey": "stageAuth",
   "shell": "studio_auth_shell",
   "consumes": "session",
   "produces": "credentials",
   "href": "/auth",
   "enabled": true
  },
  {
   "id": "intake",
   "labelKey": "stageIntake",
   "shell": "studio_intake_shell",
   "consumes": "brief + brand assets",
   "produces": "intake/registry.json",
   "href": "/intake",
   "enabled": true
  },
  {
   "id": "design",
   "labelKey": "stageDesign",
   "shell": "studio_design_shell",
   "consumes": "intake/registry.json",
   "produces": "design artifact",
   "href": "/design",
   "enabled": true
  }
 ],
 "shells": [
  {
   "id": "studio_application_hub",
   "kind": "hub",
   "views": [
    "studio_application_hub_view"
   ],
   "widgets": [
    "header",
    "tabbar",
    "rail",
    "footer_panel"
   ]
  },
  {
   "id": "studio_dashboard_shell",
   "kind": "shell",
   "views": [
    "studio_dashboard_view"
   ],
   "widgets": [
    "header_panel",
    "footer_panel",
    "main_panel",
    "gate_strip",
    "project_grid",
    "stats_row",
    "pairing_modal",
    "wizard"
   ]
  },
  {
   "id": "studio_startup_shell",
   "kind": "ceremony",
   "views": [
    "studio_startup_view",
    "studio_splash_view"
   ],
   "widgets": [
    "boot_checklist",
    "proceed_trigger"
   ]
  },
  {
   "id": "studio_unknown_shell",
   "kind": "ceremony",
   "views": [
    "studio_unknown_view"
   ],
   "widgets": [
    "unknown_notice"
   ]
  },
  {
   "id": "studio_auth_shell",
   "kind": "ceremony",
   "views": [
    "studio_auth_view"
   ],
   "widgets": [
    "credential_form"
   ]
  },
  {
   "id": "studio_intake_shell",
   "kind": "working",
   "views": [
    "studio_intake_interview_view",
    "studio_intake_personas_view",
    "studio_intake_surfaces_view",
    "studio_intake_flows_view",
    "studio_intake_mapping_view",
    "studio_intake_direction_view",
    "studio_intake_brief_view",
    "studio_intake_moodboard_view"
   ],
   "widgets": [
    "composer_panel",
    "main_panel",
    "activity_panel",
    "timeline"
   ]
  },
  {
   "id": "studio_design_shell",
   "kind": "working",
   "views": [
    "studio_design_prototype_view",
    "studio_design_chat_view",
    "studio_design_freeze_view"
   ],
   "widgets": [
    "design_viewer",
    "composer_panel",
    "main_panel",
    "activity_panel",
    "timeline",
    "inspector_pane"
   ]
  }
 ]
}
