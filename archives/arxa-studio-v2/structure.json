  "flows": [
    {
      "id": "studio",
      "edges": [
        {
          "from": "studio_startup_shell.startup",
          "to": "studio_application_hub.hub",
          "trigger": "proceed_trigger — boot checklist complete; honors validated ?to return-to"
        },
        {
          "from": "studio_application_hub.hub",
          "to": "studio_startup_shell.startup",
          "trigger": "boot guard — un-booted session on any hosted route redirects with ?to return-to"
        },
        {
          "from": "studio_application_hub.hub",
          "to": "studio_dashboard_shell.studio_dashboard",
          "trigger": "default hosted stage — / renders the hub frame with the dashboard in the body outlet"
        },
        {
          "from": "studio_dashboard_shell.studio_dashboard",
          "to": "studio_intake_shell.studio_intake_interview",
          "trigger": "stage_card[intake] / tabbar / rail — the intake stage root IS the interview"
        },
        {
          "from": "studio_intake_shell.studio_intake_interview",
          "to": "studio_intake_shell.studio_intake_personas",
          "trigger": "step_foot next CTA — the step completes (all items confirmed/skipped)"
        },
        {
          "from": "studio_intake_shell.studio_intake_personas",
          "to": "studio_intake_shell.studio_intake_surfaces",
          "trigger": "step_foot next CTA — the step completes (all items confirmed/skipped)"
        },
        {
          "from": "studio_intake_shell.studio_intake_surfaces",
          "to": "studio_intake_shell.studio_intake_flows",
          "trigger": "step_foot next CTA — the step completes (all items confirmed/skipped)"
        },
        {
          "from": "studio_intake_shell.studio_intake_flows",
          "to": "studio_intake_shell.studio_intake_mapping",
          "trigger": "step_foot next CTA — the step completes (all items confirmed/skipped)"
        },
        {
          "from": "studio_intake_shell.studio_intake_mapping",
          "to": "studio_intake_shell.studio_intake_direction",
          "trigger": "step_foot next CTA — the step completes (all items confirmed/skipped)"
        },
        {
          "from": "studio_intake_shell.studio_intake_direction",
          "to": "studio_intake_shell.studio_intake_brief",
          "trigger": "step_foot next CTA — the step completes (all items confirmed/skipped)"
        },
        {
          "from": "studio_intake_shell.studio_intake_brief",
          "to": "studio_intake_shell.studio_intake_moodboard",
          "trigger": "step_foot next CTA — the step completes (all items confirmed/skipped)"
        },
        {
          "from": "studio_intake_shell.studio_intake_moodboard",
          "to": "studio_design_shell.studio_design_prototype",
          "trigger": "step_foot next CTA — the journey hands off to the design stage"
        },
        {
          "from": "studio_design_shell.studio_design_prototype",
          "to": "studio_design_shell.studio_design_chat",
          "trigger": "composer context — the chat shares the loop frame"
        },
        {
          "from": "studio_design_shell.studio_design_prototype",
          "to": "studio_design_shell.studio_design_freeze",
          "trigger": "freeze entry — the manifest approval gate"
        },
        {
          "from": "studio_dashboard_shell.studio_dashboard",
          "to": "studio_design_shell.studio_design_prototype",
          "trigger": "stage_card[design] / tabbar / rail"
        }
      ]
    }
  ]
}
