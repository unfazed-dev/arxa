# --- Flutter / Dart ---
.dart_tool/
.packages
.pub-cache/
.pub/
build/
# `build/` above means build OUTPUT. A design artifact can legitimately own a
# surface tab named "build" — and one does: this pattern silently swallowed
# build.run, build.finding and build.approve out of a commit that reported 58
# files and looked complete. Nothing failed; the tree on disk rendered green
# while the tree in git could not serve /build at all.
!designs/*/ui/views/**/build/
*.dill
*.lock.bak
# pubspec.lock is deliberately NOT ignored — appbox is an application, and its
# whole thesis is reproducibility. The kit arrives as ~39 git deps pinned to a
# commit SHA; an unlocked resolve is exactly the ambient-state defect the
# research documents (see docs/research/spine-findings.md).
.flutter-plugins
.flutter-plugins-dependencies
generated_plugin_registrant.dart
*.g.dart.bak
/coverage/

# --- macOS desktop (the dogfood target) ---
macos/Flutter/ephemeral/
macos/Pods/
macos/.symlinks/
**/xcuserdata/
*.xcworkspace/xcshareddata/IDEWorkspaceChecks.plist

# --- Python tooling (pipeline / emitters) ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# --- Node (htmx producer runtime) ---
node_modules/
npm-debug.log*
.npm/

# --- pipeline / run state (regenerated, never authoritative) ---
.pipeline/
.appbox/
.blueprint/
# appboxd runtime state — raw memory events (M1: JSONL is git-ignored),
# scorecard/usage attribution streams, per-run manifests. Runtime state,
# not source; the tracked curated layer is memory/ at the repo root.
pipeline/state/memory/
pipeline/state/scorecard.jsonl
pipeline/state/usage.jsonl
pipeline/state/runs/
# appboxd runtime state (cont.): the offline licence file when it lives in the
# repo (preferred home is ~/.appbox/licence.json).
pipeline/state/licence.json
# .kit/ — gate SARIF + per-run state (run_all writes .kit/state/gates.sarif)
.kit/
.claude-flow/
.kim[i]-code/
*.run.json
*.history.jsonl

# --- audit + scratch (one canonical file per run, never accumulated) ---
.audit/
scratch/
*.tmp

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json
*.swp

# designer runtime deps — installed at setup, never vendored (plan 01 step 1.11b)
skills/**/node_modules/
