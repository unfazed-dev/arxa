        "widgets": [
          "KitCan"
        ]
      },
      "providers": [
        {
          "name": "SeedAuthBackend",
          "verification": "port-tested",
          "notes": "implemented 2026-08-01 — kit/auth/lib/src/backends/seed_auth_backend.dart is a genuine port of the tier1 spec (no UnimplementedError); behavior suite green at kit/auth/test/backends/seed_auth_backend_test.dart. tier1.dart remains the pure-Dart paired spec (appboxd cannot depend on the Flutter kit). No device surface — port-tested is the honest ceiling."
        },
        {
          "name": "Apple SignIn",
          "verification": "port-tested",
          "notes": "implemented 2026-08-01 — kit/auth Apple provider wraps sign_in_with_apple 8.1.0; unit tests green at the mocked platform boundary. Simulator smoke (Apple ID signed into Simulator; a missing capability fails silently) documented in docs/plans/stub-remediation.md Tier 2, not yet run — tier stays port-tested."
        },
        {
          "name": "Google SignIn",
          "verification": "port-tested",
          "notes": "implemented 2026-08-01 — kit/auth Google provider wraps google_sign_in 7.2.0; unit tests green at the mocked platform boundary. Simulator smoke (ASWebAuthenticationSession on iOS sim; Play Services image + registered debug SHA-1 on Android emu) documented in docs/plans/stub-remediation.md Tier 2, not yet run — tier stays port-tested."
        }
      ]
