{
  "$id": "flutter-crew.canonical-primitives",
  "$comment": "Shape: categories (object) + primitives[]: { id, label, category, role, variants, props, detect }. CanonicalPrimitiveSet definition in ../schemas/breakdown.schema.json.",
  "version": "1.0.0",
  "updated": "2026-06-20",
  "purpose": "Platform-neutral UI primitive vocabulary. analyze/extract EMIT these ids; map-ios/map-droid/map-web CONSUME them. Every HTML element that carries visual/interactive meaning MUST resolve to one id. If an element does not map, add an id here rather than inventing a platform-specific name downstream.",
  "idFormat": "<category>.<name>, lowercase, hyphen-separated. Variants live in the `variants` array, never as separate ids.",
  "categories": {
    "surface": "Surfaces & chrome — containers, layers, navigation chrome that floats above content.",
    "action": "Interactive controls the user taps/clicks to do something.",
    "input": "Controls that capture or edit a value.",
    "feedback": "Transient state — progress, loading, alerts, toasts.",
    "display": "Presentational — text, icons, images, dividers, badges.",
    "navigation": "Wayfinding between views or within data.",
    "data": "Collections / structured data display.",
    "motion": "Feel/animation properties applied to any primitive (cross-cutting; consumed to pick platform motion APIs)."
  },
  "primitives": [
    { "id": "surface.card", "label": "Card", "category": "surface", "role": "Self-contained grouped content surface; elevated, rounded, padded.", "variants": ["elevated","filled","outlined","glass"], "props": { "radius": "token", "padding": "token", "elevation": "int", "glass": "bool" }, "detect": { "tag": ["article","section"], "role": ["group","region"], "class": ["card","surface","panel","tile"], "css": ["border-radius","box-shadow","backdrop-filter"] } },
    { "id": "surface.panel", "label": "Panel", "category": "surface", "role": "Opaque grouped content block (not floating).", "variants": ["flat","inset"], "props": { "radius": "token", "background": "token" }, "detect": { "tag": ["div","section"], "class": ["panel","block","container","section"] } },
    { "id": "surface.glass", "label": "Glass surface", "category": "surface", "role": "Translucent frosted floating layer over content (liquid glass / blur).", "variants": ["regular","clear"], "props": { "blur": "int", "tint": "color", "radius": "token", "interactive": "bool" }, "detect": { "class": ["glass","blur","frosted","glassmorphism"], "css": ["backdrop-filter:blur","-webkit-backdrop-filter","background:rgba"] } },
    { "id": "surface.sheet", "label": "Sheet / drawer", "category": "surface", "role": "Bottom or side-anchored overlay panel, partial height, dismissible.", "variants": ["bottom","top","left","right","modal"], "props": { "detents": ["medium","large"], "grabber": "bool" }, "detect": { "tag": ["aside"], "role": ["dialog"], "class": ["sheet","drawer","bottom-sheet","panel-bottom"] } },
    { "id": "surface.modal", "label": "Modal dialog", "category": "surface", "role": "Centered overlay with scrim backdrop; blocks interaction.", "variants": ["alert","confirm","form"], "props": { "scrim": "bool", "dismissible": "bool" }, "detect": { "tag": ["dialog"], "role": ["dialog","alertdialog"], "class": ["modal","dialog","overlay"] } },
    { "id": "surface.popover", "label": "Popover", "category": "surface", "role": "Small float anchored to a trigger; non-modal.", "variants": ["menu","info"], "props": { "anchor": "ref" }, "detect": { "role": ["tooltip","menu"], "class": ["popover","flyout","dropdown"] } },
    { "id": "surface.tooltip", "label": "Tooltip", "category": "surface", "role": "Tiny anchored label on hover/long-press.", "variants": ["plain","rich"], "props": {}, "detect": { "role": ["tooltip"], "class": ["tooltip","hint"] } },
    { "id": "surface.toolbar", "label": "App bar / toolbar", "category": "surface", "role": "Top chrome: title, leading/trailing actions.", "variants": ["large","compact","transparent"], "props": { "title": "string", "actions": "action[]" }, "detect": { "tag": ["header"], "role": ["toolbar","banner"], "class": ["appbar","toolbar","navbar","header","top-bar"] } },
    { "id": "surface.tabbar", "label": "Bottom tab bar", "category": "surface", "role": "Primary mobile navigation, fixed bottom, 3-5 destinations.", "variants": ["floating","compact"], "props": { "items": "nav[]", "minimize-on-scroll": "bool" }, "detect": { "tag": ["nav"], "role": ["tablist","navigation"], "class": ["tabbar","bottom-nav","tab-bar"] } },
    { "id": "surface.navrail", "label": "Navigation rail", "category": "surface", "role": "Side navigation for large screens; collapses to tabbar on small.", "variants": ["expanded","collapsed"], "props": { "items": "nav[]" }, "detect": { "class": ["nav-rail","sidebar-nav","rail","wide-navigation-rail"] } },
    { "id": "surface.sidebar", "label": "Sidebar", "category": "surface", "role": "Fixed side content panel (filters, master list).", "variants": ["fixed","drawer"], "props": {}, "detect": { "tag": ["aside"], "class": ["sidebar","side-panel"] } },
    { "id": "surface.list", "label": "List", "category": "surface", "role": "Vertical stack of homogeneous rows.", "variants": ["plain","grouped","inset"], "props": { "dividers": "bool" }, "detect": { "tag": ["ul","ol"], "role": ["list"], "class": ["list","rows"] } },
    { "id": "surface.grid", "label": "Grid", "category": "surface", "role": "2D arrangement of cells.", "variants": ["fixed","responsive","masonry"], "props": { "columns": "int", "gap": "token" }, "detect": { "class": ["grid","gallery","tiles"], "css": ["display:grid"] } },

    { "id": "action.button", "label": "Button", "category": "action", "role": "Tap target that triggers an action.", "variants": ["primary","secondary","outline","ghost","destructive","link","glass"], "props": { "label": "string", "icon": "ref", "size": "mini|small|regular|large|extraLarge", "loading": "bool", "full-width": "bool" }, "detect": { "tag": ["button","a"], "role": ["button"], "class": ["btn","button","cta"] } },
    { "id": "action.icon-button", "label": "Icon button", "category": "action", "role": "Square button holding only an icon.", "variants": ["standard","filled","tonal","outlined"], "props": { "icon": "ref", "badge": "int" }, "detect": { "class": ["icon-btn","icon-button","icon-button","square-btn"] } },
    { "id": "action.fab", "label": "Floating action button", "category": "action", "role": "Circular/extended primary action floating above content.", "variants": ["small","regular","large","extended","menu"], "props": { "icon": "ref", "label": "string" }, "detect": { "class": ["fab","floating-action","float-btn"] } },
    { "id": "action.segmented", "label": "Segmented control", "category": "action", "role": "Mutually-exclusive pill toggle group.", "variants": ["plain","selected-indicator"], "props": { "segments": "string[]", "selected": "int" }, "detect": { "role": ["radiogroup","tablist"], "class": ["segmented","segmented-control","toggle-group","pill-group"] } },
    { "id": "action.switch", "label": "Switch", "category": "action", "role": "On/off binary toggle.", "variants": ["standard"], "props": { "on": "bool" }, "detect": { "role": ["switch"], "class": ["switch","toggle"] } },
    { "id": "action.checkbox", "label": "Checkbox", "category": "action", "role": "Binary or indeterminate selection.", "variants": ["standard","card"], "props": { "checked": "bool|indeterminate" }, "detect": { "role": ["checkbox"], "tag": ["input[type=checkbox]"] } },
    { "id": "action.radio", "label": "Radio", "category": "action", "role": "One-of-many selection within a group.", "variants": ["standard","card"], "props": { "checked": "bool" }, "detect": { "role": ["radio"], "tag": ["input[type=radio]"] } },
    { "id": "action.chip", "label": "Chip / tag", "category": "action", "role": "Compact element: filter, choice, input, or status.", "variants": ["assist","filter","input","suggestion","status"], "props": { "label": "string", "selected": "bool", "removable": "bool", "icon": "ref" }, "detect": { "role": ["button","option"], "class": ["chip","tag","pill","badge-interactive"] } },
    { "id": "action.link", "label": "Text link", "category": "action", "role": "Inline navigable text.", "variants": ["inline","embedded"], "props": {}, "detect": { "tag": ["a:not(.btn)"] } },

    { "id": "input.text-field", "label": "Text field", "category": "input", "role": "Single-line text entry.", "variants": ["filled","outlined","underlined","glass"], "props": { "label": "string", "placeholder": "string", "icon": "ref", "helper": "string", "error": "string", "secure": "bool" }, "detect": { "tag": ["input[type=text]","input[type=email]","input[type=password]"], "role": ["textbox"], "class": ["input","field","text-field"] } },
    { "id": "input.textarea", "label": "Textarea", "category": "input", "role": "Multi-line text entry.", "variants": ["filled","outlined"], "props": { "label": "string", "rows": "int" }, "detect": { "tag": ["textarea"] } },
    { "id": "input.search", "label": "Search field", "category": "input", "role": "Text field with query semantics + clear.", "variants": ["standard","glass"], "props": { "placeholder": "string" }, "detect": { "tag": ["input[type=search]","input.search"], "role": ["searchbox"], "class": ["search","search-bar","search-field"] } },
    { "id": "input.select", "label": "Select (single)", "category": "input", "role": "Choose one from a list via dropdown.", "variants": ["filled","outlined","glass"], "props": { "label": "string", "options": "string[]" }, "detect": { "tag": ["select"], "role": ["combobox","listbox"], "class": ["select","dropdown-select"] } },
    { "id": "input.multiselect", "label": "Multi-select", "category": "input", "role": "Choose many; chips or checkboxes.", "variants": ["chips","checklist"], "props": {}, "detect": { "class": ["multiselect","multi-select","chips-input"] } },
    { "id": "input.slider", "label": "Slider", "category": "input", "role": "Continuous/discrete range value.", "variants": ["continuous","discrete","range"], "props": { "min": "num", "max": "num", "steps": "int" }, "detect": { "tag": ["input[type=range]"], "role": ["slider"], "class": ["slider","range"] } },
    { "id": "input.stepper", "label": "Stepper", "category": "input", "role": "Numeric +/- adjuster.", "variants": ["inline","segmented"], "props": { "value": "num", "step": "num" }, "detect": { "class": ["stepper","counter","number-input"] } },
    { "id": "input.date-picker", "label": "Date picker", "category": "input", "role": "Calendar-based date entry.", "variants": ["dialog","inline"], "props": {}, "detect": { "class": ["datepicker","date-picker","calendar"] } },
    { "id": "input.toggle-group", "label": "Toggle group (multi)", "category": "input", "role": "Many-of-many connected toggles.", "variants": ["connected"], "props": {}, "detect": { "class": ["toggle-button-group","button-group"] } },

    { "id": "feedback.progress", "label": "Progress (determinate)", "category": "feedback", "role": "Known-percentage completion bar/ring.", "variants": ["linear","circular"], "props": { "value": "0..1" }, "detect": { "role": ["progressbar"], "tag": ["progress"], "class": ["progress","progress-bar"] } },
    { "id": "feedback.spinner", "label": "Spinner (indeterminate)", "category": "feedback", "role": "Unknown-duration loading indicator.", "variants": ["circular","linear","wavy","multi-color"], "props": {}, "detect": { "class": ["spinner","loader","loading","skeleton-loader"], "aria": ["aria-busy"] } },
    { "id": "feedback.toast", "label": "Toast / snackbar", "category": "feedback", "role": "Transient bottom message with optional action.", "variants": ["plain","action","stacked"], "props": { "duration": "ms" }, "detect": { "role": ["status","alert"], "class": ["toast","snackbar","sonner"] } },
    { "id": "feedback.alert", "label": "Alert / banner", "category": "feedback", "role": "Inline persistent message.", "variants": ["info","success","warning","error"], "props": { "dismissible": "bool" }, "detect": { "role": ["alert"], "class": ["alert","banner","callout","notice"] } },
    { "id": "feedback.skeleton", "label": "Skeleton", "category": "feedback", "role": "Placeholder shimmer for loading content.", "variants": ["text","circle","rect"], "props": {}, "detect": { "class": ["skeleton","shimmer","placeholder"] } },
    { "id": "feedback.badge", "label": "Badge", "category": "feedback", "role": "Small status/count marker.", "variants": ["count","dot","status","label"], "props": { "tone": "color" }, "detect": { "class": ["badge","pill","count","notification-dot"] } },

    { "id": "display.text", "label": "Text", "category": "display", "role": "Static text; tier drives typography scale.", "variants": ["display","title","subtitle","body","caption","label","overline"], "props": { "tier": "variant", "weight": "regular|medium|semibold|bold", "align": "start|center|end" }, "detect": { "tag": ["h1","h2","h3","h4","h5","h6","p","span","label","small"], "class": ["title","headline","subtitle","caption","overline","label"] } },
    { "id": "display.icon", "label": "Icon", "category": "display", "role": "Symbolic glyph.", "variants": ["filled","outlined","symbol"], "props": { "name": "string", "size": "token" }, "detect": { "tag": ["svg","img[icon]"], "class": ["icon","material-icons","lucide"] } },
    { "id": "display.avatar", "label": "Avatar", "category": "display", "role": "Circular user/entity image or initials.", "variants": ["image","initials","icon"], "props": { "size": "token" }, "detect": { "class": ["avatar","profile-pic","user-avatar"] } },
    { "id": "display.divider", "label": "Divider / separator", "category": "display", "role": "Horizontal/vertical rule.", "variants": ["full","inset"], "props": {}, "detect": { "tag": ["hr"], "class": ["divider","separator"] } },
    { "id": "display.media", "label": "Media", "category": "display", "role": "Image, video, or illustration.", "variants": ["image","video","illustration","cover"], "props": { "ratio": "ratio", "rounded": "bool" }, "detect": { "tag": ["img","video","picture","figure"], "class": ["media","cover","hero-image"] } },
    { "id": "display.stat", "label": "Stat / metric", "category": "display", "role": "Big number + label KPI.", "variants": ["plain","trend"], "props": { "value": "string", "label": "string", "delta": "string" }, "detect": { "class": ["stat","metric","kpi"] } },
    { "id": "display.empty-state", "label": "Empty state", "category": "display", "role": "Illustration + copy for no-data.", "variants": ["plain","actionable"], "props": {}, "detect": { "class": ["empty-state","empty","placeholder-illustration"] } },

    { "id": "navigation.tabs", "label": "Tabs (top)", "category": "navigation", "role": "Switch views within a screen, top-anchored.", "variants": ["fixed","scrollable","pill"], "props": { "tabs": "string[]" }, "detect": { "role": ["tablist"], "class": ["tabs","tab-list","top-tabs"] } },
    { "id": "navigation.breadcrumb", "label": "Breadcrumb", "category": "navigation", "role": "Hierarchical path trail.", "variants": ["plain"], "props": {}, "detect": { "class": ["breadcrumb","crumbs"] } },
    { "id": "navigation.pagination", "label": "Pagination", "category": "navigation", "role": "Page navigation controls.", "variants": ["numbered","load-more"], "props": {}, "detect": { "class": ["pagination","pager"] } },
    { "id": "navigation.dropdown-menu", "label": "Dropdown menu", "category": "navigation", "role": "List of actions/options from a trigger.", "variants": ["simple","grouped","checkable"], "props": {}, "detect": { "role": ["menu"], "class": ["dropdown-menu","menu"] } },
    { "id": "navigation.context-menu", "label": "Context menu", "category": "navigation", "role": "Menu invoked by right-click / long-press.", "variants": ["simple"], "props": {}, "detect": { "class": ["context-menu"] } },
    { "id": "navigation.command", "label": "Command palette", "category": "navigation", "role": "Cmd/K-style fuzzy action search.", "variants": ["modal"], "props": {}, "detect": { "class": ["command","command-palette","cmdk"] } },
    { "id": "navigation.menubar", "label": "Menubar", "category": "navigation", "role": "Persistent horizontal menu bar.", "variants": ["plain"], "props": {}, "detect": { "class": ["menubar"] } },

    { "id": "data.table", "label": "Table", "category": "data", "role": "Rows/columns of cells.", "variants": ["plain","striped","bordered"], "props": { "columns": "int" }, "detect": { "tag": ["table"], "class": ["table"] } },
    { "id": "data.data-table", "label": "Data table", "category": "data", "role": "Sortable/filterable/paginated table.", "variants": ["interactive","tree"], "props": { "sortable": "bool", "selectable": "bool" }, "detect": { "class": ["data-table","grid","data-grid"] } },
    { "id": "data.carousel", "label": "Carousel", "category": "data", "role": "Horizontal sliding item gallery.", "variants": ["hero","multi","stratified"], "props": { "peek": "bool" }, "detect": { "class": ["carousel","slider","swiper"] } },
    { "id": "data.timeline", "label": "Timeline", "category": "data", "role": "Chronological event list.", "variants": ["vertical","horizontal"], "props": {}, "detect": { "class": ["timeline","feed","log"] } },
    { "id": "data.accordion", "label": "Accordion", "category": "data", "role": "Collapsible stacked sections.", "variants": ["single","multi"], "props": {}, "detect": { "class": ["accordion","collapsible","disclosure"] } },
    { "id": "data.row", "label": "Data row", "category": "data", "role": "Single structured row of cells (label/value, key/value, numbered step); the atomic unit of a list or table. Repeated via props.repeat.", "variants": ["plain","key-value","numbered","two-line"], "props": { "cells": "string[]", "leading": "ref", "trailing": "ref", "repeat": "int" }, "detect": { "class": ["row","kv","step-row","list-row","list-item"] } },
    { "id": "data.chart", "label": "Chart", "category": "data", "role": "Quantitative data visualization (sparkline, bar, heatmap, line, pie). Not a table; values plotted graphically.", "variants": ["bar","line","sparkline","heatmap","pie","donut"], "props": { "series": "number[]|series[]", "title": "string", "min": "num", "max": "num" }, "detect": { "class": ["chart","bars","sparkline","heatmap","spark","graph","plot"] } },

    { "id": "motion.glass-blur", "label": "Glass blur (translucency)", "category": "motion", "role": "Cross-cutting: marks a surface primitive as translucent frosted. Drives .glassEffect / .ultraThinMaterial / Surface blur.", "props": { "tint": "color" }, "detect": { "css": ["backdrop-filter","background:rgba","filter:blur"] } },
    { "id": "motion.spring-press", "label": "Spring press", "category": "motion", "role": "Press-to-scale spring feedback on an action primitive.", "props": {}, "detect": { "css": ["transform:scale","transition"], "class": ["press","tap","active:scale"] } },
    { "id": "motion.morph", "label": "Morph transition", "category": "motion", "role": "Shared-element shape morph between two primitives (e.g. card expands to sheet).", "props": { "id": "string" }, "detect": { "class": ["morph","shared-element"] } },
    { "id": "motion.rise-in", "label": "Rise-in entrance", "category": "motion", "role": "Content enters by translating up + fading.", "props": {}, "detect": { "class": ["rise","fade-in-up","enter"], "css": ["@keyframes","animation"] } },
    { "id": "motion.parallax", "label": "Parallax / scroll-coupled", "category": "motion", "role": "Element translates with scroll.", "props": {}, "detect": { "class": ["parallax","scroll-coupled"] } }
  ],
  "motions": "motion.* are not standalone widgets and are NOT keys in a platform catalog's `map`. They are FLAGS attached to a surface/action/display primitive via its `motion` field. Each platform catalog exposes per-flag motion RECIPES in a separate top-level `motions` object; the mapper consults motions[flag] (NOT map[id]) to select the right motion/glass API and folds it into the primitive's mapping notes.",
  "exhaustivenessRule": "extract MUST classify EVERY interactive or visually-load-bearing node. Decorative wrappers (pure layout <div> with no styling/role) are skipped and noted in `skipped`.",
  "providerPlatformBindings": {
    "$comment": "Provider -> platforms allowlist. The single source of truth for platform-incompatible auth/social providers. A provider absent here is all-platform. A provider listed with a strict subset of platforms means a primitive bound to it (action.button whose design onClick fires go('<provider>')) does NOT exist on the excluded platforms and MUST be omitted at generate-time (not suppressed at runtime) there. map_all emits a `platforms` allowlist on the primitive's per-platform mappings ONLY when narrower than the resolved set (golden-neutral); parity reads it to partition 'missing' into expected_absent vs dropped. Extensible: add a provider here when a design introduces a new platform-bound sign-in (e.g. a web-only OAuth).",
    "apple": ["ios"],
    "google": ["ios", "android", "web"]
  }
}
