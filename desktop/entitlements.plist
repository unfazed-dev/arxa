<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      Sidecar entitlements for hardened-runtime signing.
      Grounded in nodejs/node tools/osx-entitlements.plist (production subset):
      Node/bun-based sidecars (V8 JIT) need writable+executable memory under
      the hardened runtime. Dart AOT sidecars don't need these but are
      unharmed by them. Debug-only keys (get-task-allow,
      disable-executable-page-protection) deliberately omitted —
      notarization rejects get-task-allow.
    -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
</dict>
</plist>
