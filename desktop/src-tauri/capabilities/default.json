{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: core defaults plus permission to spawn the two arxa sidecars (studio engine + arxa CLI).",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "updater:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        { "name": "binaries/arxa-studio", "sidecar": true },
        { "name": "binaries/arxa", "sidecar": true }
      ]
    }
  ]
}
