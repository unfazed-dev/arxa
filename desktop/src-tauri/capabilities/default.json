{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main + pairing windows: core defaults plus permission to spawn the two arxa sidecars (studio engine + arxa CLI).",
  "windows": ["main", "pair"],
  "permissions": [
    "core:default",
    "updater:default",
    "allow-studio-url",
    "allow-open-studio",
    "allow-open-pairing-window",
    "allow-get-theme",
    "allow-pairing-begin",
    "allow-pairing-status",
    "allow-pairing-revoke",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        { "name": "binaries/arxa-studio", "sidecar": true },
        { "name": "binaries/arxa", "sidecar": true }
      ]
    }
  ]
}
