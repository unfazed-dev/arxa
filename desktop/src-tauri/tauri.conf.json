{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Arxa Studio",
  "version": "0.1.1",
  "identifier": "solutions.arxadigital.arxa",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Arxa Studio",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "userAgent": "Mozilla/5.0 (Macintosh) ArxaShell/0.1"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost http://localhost:* http://127.0.0.1:* http://*.localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "externalBin": [
      "binaries/arxa-studio",
      "binaries/arxa"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "entitlements": "../entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNGODRCMjg2NDZBQjQxMjQKUldRa1FhdEdocktFUDkyUjJwL1pPQ3hRdWVaWEFYYzl1TzR3YU05VVNTQXZTUGs1bDRRKzk5RWUK",
      "endpoints": [
        "https://raw.githubusercontent.com/unfazed-dev/arxa-releases/main/desktop/stable/{{target}}/{{arch}}/latest.json"
      ]
    }
  }
}
