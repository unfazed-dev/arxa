{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Arxa Studio",
  "version": "0.1.0",
  "identifier": "solutions.arxadigital.arxa",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Arxa Studio",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost http://localhost:* http://127.0.0.1:* http://*.localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "externalBin": [
      "binaries/arxa-studio",
      "binaries/arxa"
    ],
    "icon": ["icons/icon.png"]
  }
}
