{
  "$schema": "appbox/structure@2",
  "registry": "models/screens_model/registry.json",
  "shellRoots": {
    "studio_application_hub": "/",
    "studio_dashboard_shell": "/dashboard",
    "studio_startup_shell": "/startup",
    "studio_unknown_shell": "/unknown",
    "studio_auth_shell": "/auth",
    "studio_intake_shell": "/intake",
    "studio_design_shell": "/design"
  },
  "screens": [
    {
      "id": "studio_application_hub.hub",
      "shell": "studio_application_hub",
      "comp": "StudioApplicationHub",
      "shellDir": "studio_application_hub",
      "surface": "studio_application_hub_view",
      "viewmodel": "ui/views/studio_application_hub/studio_application_hub_viewmodel.js",
      "deps": [],
      "surfaceKey": "studio_application_hub"
    },
    {
      "id": "studio_dashboard_shell.studio_dashboard",
      "shell": "studio_dashboard_shell",
      "comp": "StudioDashboard",
      "shellDir": "studio_dashboard_shell",
      "surface": "studio_dashboard_view",
      "viewmodel": "ui/views/studio_dashboard_shell/studio_dashboard/studio_dashboard_viewmodel.js",
      "deps": [
        "services/studio_dashboard_services/facades/studio_dashboard_facade_service.js"
      ],
      "surfaceKey": "studio_dashboard"
    },
    {
      "id": "studio_startup_shell.startup",
      "shell": "studio_startup_shell",
      "comp": "StudioStartup",
      "shellDir": "studio_startup_shell",
      "surface": "studio_startup_view",
      "viewmodel": "ui/views/studio_startup_shell/studio_startup/studio_startup_viewmodel.js",
      "deps": [
        "services/studio_startup_services/facades/studio_startup_facade_service.js"
      ],
      "surfaceKey": "studio_startup"
    },
    {
      "id": "studio_startup_shell.splash",
      "shell": "studio_startup_shell",
      "comp": "StudioSplash",
      "shellDir": "studio_startup_shell",
      "surface": "studio_splash_view",
      "viewmodel": "ui/views/studio_startup_shell/splash/studio_splash_viewmodel.js",
      "deps": [],
      "surfaceKey": "studio_splash"
    },
    {
      "id": "studio_unknown_shell.unknown",
      "shell": "studio_unknown_shell",
      "comp": "StudioUnknown",
      "shellDir": "studio_unknown_shell",
      "surface": "studio_unknown_view",
      "viewmodel": "ui/views/studio_unknown_shell/studio_unknown/studio_unknown_viewmodel.js",
      "deps": [],
      "surfaceKey": "studio_unknown"
    },
    {
      "id": "studio_auth_shell.auth",
      "shell": "studio_auth_shell",
      "comp": "StudioAuth",
      "shellDir": "studio_auth_shell",
      "surface": "studio_auth_view",
      "viewmodel": "ui/views/studio_auth_shell/studio_auth/studio_auth_viewmodel.js",
      "deps": [
        "services/studio_auth_services/facades/studio_auth_facade_service.js"
      ],
      "surfaceKey": "studio_auth"
    },
    {
      "id": "studio_intake_shell.intake",
      "shell": "studio_intake_shell",
      "comp": "StudioIntake",
      "shellDir": "studio_intake_shell",
      "surface": "studio_intake_view",
      "viewmodel": "ui/views/studio_intake_shell/studio_intake/studio_intake_viewmodel.js",
      "deps": [
        "services/studio_intake_services/facades/studio_intake_facade_service.js"
      ],
      "surfaceKey": "studio_intake"
    },
    {
      "id": "studio_design_shell.design",
      "shell": "studio_design_shell",
      "comp": "StudioDesign",
      "shellDir": "studio_design_shell",
      "surface": "studio_design_view",
      "viewmodel": "ui/views/studio_design_shell/studio_design/studio_design_viewmodel.js",
      "deps": [
        "services/studio_design_services/facades/studio_design_facade_service.js"
      ],
      "surfaceKey": "studio_design"
    }
  ],
  "flows": [
    {
      "id": "studio",
      "edges": [
        {
          "from": "studio_startup_shell.startup",
          "to": "studio_application_hub.hub",
          "trigger": "proceed_trigger — boot checklist complete; honors validated ?to return-to"
        },
        {
          "from": "studio_application_hub.hub",
          "to": "studio_startup_shell.startup",
          "trigger": "boot guard — un-booted session on any hosted route redirects with ?to return-to"
        },
        {
          "from": "studio_application_hub.hub",
          "to": "studio_dashboard_shell.studio_dashboard",
          "trigger": "default hosted stage — / renders the hub frame with the dashboard in the body outlet"
        },
        {
          "from": "studio_dashboard_shell.studio_dashboard",
          "to": "studio_startup_shell.startup",
          "trigger": "stage_card[startup]"
        },
        {
          "from": "studio_application_hub.hub",
          "to": "studio_auth_shell.auth",
          "trigger": "requiresAuth guard on gated stages — pending shell (Q-v2-5), declared as data only"
        },
        {
          "from": "studio_dashboard_shell.studio_dashboard",
          "to": "studio_auth_shell.auth",
          "trigger": "stage_card[auth] — disabled until shell lands (Q-v2-5)"
        },
        {
          "from": "studio_dashboard_shell.studio_dashboard",
          "to": "studio_intake_shell.intake",
          "trigger": "stage_card[intake] — disabled until shell lands (Q-v2-5)"
        },
        {
          "from": "studio_dashboard_shell.studio_dashboard",
          "to": "studio_design_shell.design",
          "trigger": "stage_card[design] — disabled until shell lands (Q-v2-5)"
        },
        {
          "from": "studio_auth_shell.auth",
          "to": "studio_intake_shell.intake",
          "trigger": "per-shell manual proceed — credentials produced"
        },
        {
          "from": "studio_intake_shell.intake",
          "to": "studio_design_shell.design",
          "trigger": "per-shell manual proceed — intake/registry.json pinned"
        },
        {
          "from": "studio_unknown_shell.unknown",
          "to": "studio_application_hub.hub",
          "trigger": "cta-link — return to the studio root"
        }
      ]
    }
  ]
}
