  "flows": [
    {
      "id": "flow-intake",
      "name": "New project intake",
      "persona": "persona-client",
      "provenance": "inferred",
      "edges": [
        {
          "from": "app.dashboard",
          "to": "intake.interview",
          "trigger": "New project",
          "label": "start"
        },
        {
          "from": "intake.interview",
          "to": "intake.personas",
          "trigger": "Questions answered"
        },
        {
          "from": "intake.personas",
          "to": "intake.surfaces",
          "trigger": "Personas confirmed"
        },
        {
          "from": "intake.surfaces",
          "to": "intake.flows",
          "trigger": "Inventory confirmed"
        },
        {
          "from": "intake.flows",
          "to": "intake.mapping",
          "trigger": "Flows confirmed"
        },
        {
          "from": "intake.mapping",
          "to": "intake.direction",
          "trigger": "Map approved"
        },
        {
          "from": "intake.direction",
          "to": "intake.brief",
          "trigger": "Direction confirmed"
        },
        {
          "from": "intake.brief",
          "to": "design.prototype",
          "trigger": "Brief approved",
          "label": "handoff"
        }
      ]
    },
    {
      "id": "flow-build",
      "name": "Design to build",
      "persona": "persona-designer",
      "provenance": "inferred",
      "edges": [
        {
          "from": "design.prototype",
          "to": "design.freeze",
          "trigger": "Freeze"
        },
        {
          "from": "design.freeze",
          "to": "scaffold.picker",
          "trigger": "Scaffold"
        },
        {
          "from": "scaffold.picker",
          "to": "scaffold.run",
          "trigger": "Scaffold selected kits"
        },
        {
          "from": "scaffold.run",
          "to": "build.loop",
          "trigger": "Scaffold complete"
        },
        {
          "from": "build.loop",
          "to": "build.gates",
          "trigger": "Run gates"
        },
        {
          "from": "build.gates",
          "to": "ship.deploy",
          "trigger": "Gates green"
        }
      ]
    },
    {
      "id": "flow-credentials",
      "name": "Connect services",
      "persona": "persona-developer",
      "provenance": "founder",
      "edges": [
        {
          "from": "workspace.settings",
          "to": "workspace.credentials",
          "trigger": "Open credentials"
        },
        {
          "from": "workspace.credentials",
          "to": "workspace.config",
          "trigger": "Add key"
        },
        {
          "from": "workspace.config",
          "to": "design.prototype",
          "trigger": "Use kit in design"
        }
      ]
    }
  ],
