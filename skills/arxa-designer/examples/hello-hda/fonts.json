          "css2": "family=Instrument+Sans:ital,wght@0,400..700;1,400..700",
          "stack": "'Instrument Sans', 'Helvetica Neue', Arial, sans-serif",
          "seeded": true,
          "sheet": "/assets/styles/fonts/font-body-instrument-sans.css"
        }
      ]
    }
  ]
