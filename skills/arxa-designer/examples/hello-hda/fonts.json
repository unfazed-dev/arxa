          "category": "Sans Serif",
          "css2": "family=Source+Sans+3:ital,wght@0,200..900;1,200..900",
          "stack": "'Source Sans 3', 'Helvetica Neue', Arial, sans-serif",
          "seeded": true,
          "sheet": "/assets/styles/fonts/font-body-source-sans-3.css"
        },
        {
