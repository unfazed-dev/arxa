# GENERATED by branding/tools/generate_branding.sh — do not edit by hand.
# flutter_native_splash config. Two things to know:
#  1. Background = the kit theme's scaffoldBackgroundColor — KitColors.surface
#     (#F5F0E8) light / KitDarkColors.bone (#1C1814) dark — so the native OS
#     splash matches the in-Flutter BrandSplash (colorScheme.surface) with no
#     color seam, and follows the system theme via color_dark. NOT the brand
#     accent. Mirrors brand_colors.dart.tmpl; update both if the kit ramp changes.
#  2. Logo size — flutter_native_splash renders `image:` at its SOURCE pixel
#     dimensions (no upscale), so pointing it at the full-res 1024px launcher
#     icon made the OS splash logo enormous. `image:` is a dedicated
#     splash_logo.png rasterized at 4× BrandSplash.logoSize (80dp -> 320px) by
#     generate_branding.sh. Android 12+ is different: it renders `image:` inside a
#     fixed ~240dp icon window, so the ON-SCREEN size is the logo's fraction of a
#     960px canvas, not raw px — the full-frame icon rendered ~2.9× the iOS logo.
#     generate_branding.sh pads a small logo into a 960 canvas (splash_logo_
#     android12.png) so android_12 matches the iOS splash. Matches the reference app (logoSize 80).
# Generate after emit:  dart run flutter_native_splash:create
#
# Handoff: native splash (instant) -> preserved past first frame ->
# FlutterNativeSplash.remove() once the in-Flutter StartupView finishes its
# brand moment (see host main.dart + startup_viewmodel).
flutter_native_splash:
  color: "#F5F0E8"
  color_dark: "#1C1814"
  image: assets/icons/splash_logo.png
  android_12:
    image: assets/icons/splash_logo_android12.png
    icon_background_color: "#F5F0E8"
    icon_background_color_dark: "#1C1814"
  web: false
