{
  "$schema": "arxa/structure@2",
  "registry": "registry.json",
  "shellRoots": {
    "pairing_shell": "/",
    "studio_shell": "/studio",
    "approvals_shell": "/approvals",
    "settings_shell": "/settings"
  },
  "screens": [
    {"id": "pairing.scan", "shell": "pairing", "comp": "PairingScan", "shellDir": "pairing_shell", "surface": "pairing_shell_pairing_scan_view", "viewmodel": "ui/views/pairing_shell/pairing_scan/pairing_scan_viewmodel.js", "deps": ["services/facades/pairing_facade.js"], "surfaceKey": "pairing_scan"},
    {"id": "pairing.connecting", "shell": "pairing", "comp": "PairingConnecting", "shellDir": "pairing_shell", "surface": "pairing_shell_connecting_view", "viewmodel": "ui/views/pairing_shell/connecting/connecting_viewmodel.js", "deps": ["services/facades/pairing_facade.js"], "surfaceKey": "connecting"},
    {"id": "pairing.push_permission", "shell": "pairing", "comp": "PairingPushPermission", "shellDir": "pairing_shell", "surface": "pairing_shell_push_permission_view", "viewmodel": "ui/views/pairing_shell/push_permission/push_permission_viewmodel.js", "deps": ["services/facades/push_facade.js"], "surfaceKey": "push_permission"},
    {"id": "studio.session", "shell": "studio", "comp": "StudioSession", "shellDir": "studio_shell", "surface": "studio_shell_studio_session_view", "viewmodel": "ui/views/studio_shell/studio_session/studio_session_viewmodel.js", "deps": ["services/facades/transport_facade.js"], "surfaceKey": "studio_session"},
    {"id": "approvals.list", "shell": "approvals", "comp": "ApprovalsList", "shellDir": "approvals_shell", "surface": "approvals_shell_approvals_view", "viewmodel": "ui/views/approvals_shell/approvals/approvals_viewmodel.js", "deps": ["services/facades/approvals_facade.js"], "surfaceKey": "approvals"},
    {"id": "settings.home", "shell": "settings", "comp": "SettingsHome", "shellDir": "settings_shell", "surface": "settings_shell_settings_view", "viewmodel": "ui/views/settings_shell/settings/settings_viewmodel.js", "deps": ["services/facades/settings_facade.js"], "surfaceKey": "settings"}
  ],
  "flows": [
    {"id": "pairing", "edges": [
      {"from": "pairing.scan", "to": "pairing.connecting", "trigger": "ticket scanned or entered"},
      {"from": "pairing.connecting", "to": "pairing.push_permission", "trigger": "connected — first pair"},
      {"from": "pairing.push_permission", "to": "studio.session", "trigger": "permission answered"},
      {"from": "studio.session", "to": "settings.home", "trigger": "settings"},
      {"from": "settings.home", "to": "pairing.scan", "trigger": "unpair"},
      {"from": "approvals.list", "to": "studio.session", "trigger": "approval handled"}
    ]}
  ]
}
