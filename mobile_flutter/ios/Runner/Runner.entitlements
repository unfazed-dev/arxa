<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- D68 phone leg: APNs registration for a development-signed build.
	     cairn-push's ApnsRail must run with CAIRN_APNS_SANDBOX=1 while the
	     app signs with a development profile; flip to "production" for
	     App Store / ad-hoc distribution. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
